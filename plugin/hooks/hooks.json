{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/pretooluse-skill.sh",
            "timeout": 10,
            "statusMessage": "한국어 스킬 적용 확인"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/posttooluse.sh",
            "timeout": 10,
            "statusMessage": "한국어 검사"
          }
        ]
      }
    ]
  }
}
