{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 hooks-handlers/test_posttooluse.py)",
      "Bash(python3 hooks-handlers/test_sessionstart.py)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/measure.sh:*)",
      "Bash(node skills/korean-character-count/scripts/korean_character_count.js:*)",
      "Bash(claude plugin validate:*)",
      "Bash(shellcheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)"
    ],
    "ask": [
      "Bash(scripts/release.sh:*)",
      "Edit(/skills/crafting-effective-readmes/**)",
      "Write(/skills/crafting-effective-readmes/**)",
      "Edit(/skills/korean-character-count/scripts/**)",
      "Write(/skills/korean-character-count/scripts/**)",
      "Edit(/.claude-plugin/plugin.json)",
      "Edit(/NOTICE.md)",
      "Edit(/LICENSE)"
    ]
  }
}
