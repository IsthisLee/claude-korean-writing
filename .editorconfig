# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# 마크다운은 줄 끝 공백 두 개가 줄바꿈이다. 지우면 안 된다.
trim_trailing_whitespace = false

[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
